{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rpxlabsphotography.vercel.app"
        }
      ],
      "destination": "https://rpxlabs.id/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rpxlabs.id"
        }
      ],
      "destination": "https://rpxlabs.id/:path*",
      "permanent": true
    },
    {
      "source": "/graduation",
      "destination": "/graduation.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}