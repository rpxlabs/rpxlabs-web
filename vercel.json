{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rpxlabsphotography.vercel.app"
        }
      ],
      "destination": "https://rpxlabs.id/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rpxlabs.id"
        }
      ],
      "destination": "https://rpxlabs.id/:path*",
      "permanent": true
    },
    {
      "source": "/graduation",
      "destination": "/graduation.html",
      "permanent": true
    },
    {
      "source": "/Payment",
      "destination": "/payment",
      "permanent": true
    },
    {
      "source": "/Bayar",
      "destination": "/payment",
      "permanent": true
    },
    {
      "source": "/Running",
      "destination": "/running",
      "permanent": true
    },
    {
      "source": "/Album",
      "destination": "/running",
      "permanent": true
    },
    {
      "source": "/Graduation",
      "destination": "/graduation",
      "permanent": true
    },
    {
      "source": "/Sport",
      "destination": "/sport",
      "permanent": true
    },
    {
      "source": "/Event",
      "destination": "/event",
      "permanent": true
    },
    {
      "source": "/Portfolio",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}